#!/usr/bin/env bash
set -eou pipefail

# Install some basic system dependencies.
sudo apt-get remove -y --auto-remove man-db
sudo apt-get update
sudo apt-get install -y --no-install-recommends curl gnupg iputils-ping

# Install mongosh
curl -fsSL https://www.mongodb.org/static/pgp/server-8.0.asc | \
  sudo gpg -o /usr/share/keyrings/mongodb-server-8.0.gpg --dearmor

echo "deb [ signed-by=/usr/share/keyrings/mongodb-server-8.0.gpg ] http://repo.mongodb.org/apt/debian bookworm/mongodb-org/8.0 main" | \
  sudo tee /etc/apt/sources.list.d/mongodb-org-8.0.list

sudo apt-get update
sudo apt-get install -y mongodb-mongosh

# Install golangci-lint. We wanted to use the `go mod tools` functionality,
# but they recommend against this: https://golangci-lint.run/welcome/install/#install-from-sources
go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.1.2
